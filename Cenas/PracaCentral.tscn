titulo_area = "FLORESTA DO TMEGA"
descricao_area = "Bosque luxuriante nas margens do rio Tâmega. Atravessa as pontes rústicas e recolhe ervas medicinais como hortelã, arnica e musgo para poções."
icone_simbolo = "🌿"

[node name="PortaDungeon" parent="." unique_id=1020710253 instance=ExtResource("3_door")]
