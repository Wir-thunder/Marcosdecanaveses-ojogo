[node name="Taberneiro" parent="YSort" instance=ExtResource("9_tavern_npc")]
position = Vector2(240, 195)
nome_npc = "Taberneiro Afonso"
profissao_npc = "Taberneiro do Vale"
falas = Array[String]([
	"Bem-vindo à Taverna do Vale, Marco! Um copo de vinho verde fresco?",
	"Hoje a lareira afasta o vento gélido que desce da serra.",
	"Tens novas poções para os aventureiros que vão descer à dungeon?",
	"O cozido farturento de feijão com carne fumada está no ponto!",
	"Se precisares de dormir para recuperar forças, os quartos do sótão estão prontos!"
])
pose_indice = 0

[node name="NpcBardo" parent="YSort" instance=ExtResource("9_tavern_npc")]
position = Vector2(362, 174)
nome_npc = "Martim, o Trovador"
profissao_npc = "Bardo"
falas = Array[String]([
	"Cantarei as glórias dos campeões na arena de Tongóbriga!",
	"Nada aquece mais a alma que uma trova dedilhada ao calor da lareira.",
	"Escutai a balada do alquimista que desvendou os segredos do Tâmega!"
])
pose_indice = 4

[node name="NpcGuerreiro" parent="YSort" instance=ExtResource("9_tavern_npc")]
position = Vector2(390, 235)
nome_npc = "Rodrigo, o Veterano"
profissao_npc = "Cavaleiro"
falas = Array[String]([
	"Esta cerveja encorpada do vale dá ânimo para qualquer combate!",
	"Comprei uma poção de espinheira real na botica e salvou a minha pele nas catacumbas!",
	"As ruínas de Tongóbriga guardam guerreiros celtas formidáveis."
])
pose_indice = 3

[node name="NpcMago" parent="YSort" instance=ExtResource("9_tavern_npc")]
position = Vector2(510, 225)
nome_npc = "Mestre Baltasar"
profissao_npc = "Mago Arcano"
falas = Array[String]([
	"As essências alquímicas do Tâmega condensam mana pura.",
	"Dizem que na mina antiga há veios de cristais azuis cintilantes.",
	"O caldeirão do Marco tem a têmpera mágica exata."
])
pose_indice = 2

[node name="NpcArqueiro" parent="YSort" instance=ExtResource("9_tavern_npc")]
position = Vector2(540, 185)
nome_npc = "Inês da Floresta"
profissao_npc = "Druida dos Bosques"
falas = Array[String]([
	"A caça nas margens do rio foi generosa e o vento soprava a favor.",
	"Esconder-se nas moitas é a melhor tática contra as feras que investem!",
	"Precisamos de mais corajosos para a próxima expedição às profundezas."
])
pose_indice = 1

[node name="NpcCurandeira" parent="YSort" instance=ExtResource("9_tavern_npc")]
position = Vector2(610, 195)
nome_npc = "Irmã Beatriz"
profissao_npc = "Curandeira"
falas = Array[String]([
	"A erva-cidreira e o musgo da floresta curam qualquer maleita.",
	"Levem elixires de proteção e poções de vento antes de descerem à mina!",
	"Que a bênção das águas do Tâmega proteja a nossa guarnição."
])
pose_indice = 5

[node name="NpcCampesinoVasco" parent="YSort" instance=ExtResource("9_tavern_npc")]
position = Vector2(280, 315)
nome_npc = "Vasco do Souto"
profissao_npc = "Pastor Aldeão"
falas = Array[String]([
	"Mais uma caneca, mestre Afonso! O pastoreio na serra foi duro hoje.",
	"Já vi muitos invernos em Marco de Canaveses, mas este ano a magia está viva.",
	"As poções do Marco têm fama até do outro lado do rio Douro."
])
pose_indice = 6

[node name="NpcCampesinoTiago" parent="YSort" instance=ExtResource("9_tavern_npc")]
position = Vector2(525, 315)
nome_npc = "Tiago das Vinhas"
profissao_npc = "Lavrador"
falas = Array[String]([
