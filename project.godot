config_version=5

[application]

config/name="Marcos de Canaveses"
config/version="0.1.0"
run/main_scene="res://Cenas/IntroCutscene.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InventoryManager="*uid://bgt8yaj7kb3x5"
SceneRouter="*res://Scripts/SceneRouter.gd"
CampaignManager="*res://Scripts/CampaignManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Marcos de canaveses- Jogo"

